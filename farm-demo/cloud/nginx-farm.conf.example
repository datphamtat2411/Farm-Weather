# Install only on a deployment host with valid server certificates.
# ThingsBoard and Farm API remain bound to loopback. No PostgreSQL or plaintext MQTT exposure.
map $http_upgrade $farm_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name weather.example.invalid;
    ssl_certificate /etc/farm/public/fullchain.pem;
    ssl_certificate_key /etc/farm/public/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;

    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/farm/internal/ca.crt;
    proxy_ssl_server_name on;
    proxy_ssl_name localhost;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $farm_connection_upgrade;

    location /api/farm/ {
        client_max_body_size 8k;
        proxy_pass https://127.0.0.1:8444;
    }
    location / {
        proxy_pass https://127.0.0.1:8443;
    }
}
